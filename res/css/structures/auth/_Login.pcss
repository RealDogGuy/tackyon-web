.mx_Login_submit {
    @mixin mx_DialogButton;
    font-size: 15px;
    font-weight: var(--cpd-font-weight-semibold);
    width: 100%;
    margin-top: 24px;
    margin-bottom: 24px;
    box-sizing: border-box;
    text-align: center;
}

.mx_Login_submit:disabled {
    opacity: 0.3;
    cursor: default;
}

.mx_Login_loader {
    display: inline;
    position: relative;
    top: 2px;
    left: 8px;
}

.mx_Login_loader .mx_Spinner {
    display: inline;
}

.mx_Login_loader .mx_Spinner img {
    width: 16px;
    height: 16px;
}

.mx_Login_error {
    color: $alert;
    font-weight: bold;
    text-align: center;
    margin-top: 12px;
    margin-bottom: 12px;
}

.mx_Login_error.mx_Login_serverError {
    text-align: left;
    font-weight: normal;
}

.mx_Login_error.mx_Login_serverError.mx_Login_serverErrorNonFatal {
    color: #ff8d13; /* Only used here */
}

.mx_Login_type_container {
    display: flex;
    align-items: center;
    color: $authpage-primary-color;

    .mx_Field {
        margin: 0;
    }
}

.mx_Login_type_label {
    flex: 1;
}

.mx_Login_underlinedServerName {
    width: max-content;
    border-bottom: 1px dashed $accent;
}

div.mx_AccessibleButton_kind_link.mx_Login_forgot {
    display: block;
    margin-top: 24px;

    &.mx_AccessibleButton_disabled {
        cursor: not-allowed;
    }
}

.mx_Login_spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    align-content: center;
    padding: 14px;
}

.mx_Login_fullWidthButton {
    width: 100%;
    margin-bottom: 16px;
}

.mx_SigninDev {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    font-family: "Azeret Mono", Inter, sans-serif;
}

.mx_SigninDev_language {
    width: min(540px, 100%);
    display: flex;
    justify-content: flex-end;
    margin: 0 auto 10px;
}

.mx_SigninDev_language .mx_AuthBody_language {
    width: auto;
    margin: 0;
}

.mx_SigninDev_language .mx_Dropdown_input {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(10, 10, 10, 0.35);
    color: rgba(255, 255, 255, 0.72);
    font-family: "Azeret Mono", Inter, sans-serif;
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    min-height: 30px;
    border-radius: 999px;
    padding: 0 8px;
}

.mx_SigninDev_language .mx_Dropdown_arrow {
    color: rgba(255, 255, 255, 0.62);
}

.mx_SigninDev_body.mx_AuthBody {
    width: min(540px, 100%);
    margin: 0;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(8, 9, 12, 0.79);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45);
    padding: 26px 18px 14px;
    text-align: left;
}

.mx_SigninDev_brand {
    margin: 0;
    font-family: "Sora", Inter, sans-serif;
    font-size: 68px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
}

.mx_SigninDev_divider {
    margin: 8px 0 18px;
    color: rgba(255, 255, 255, 0.66);
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    position: relative;
    width: 100%;
    height: 1em;
}

.mx_SigninDev_divider::before {
    content: "[--------------------------------------------------------]";
}

.mx_SigninDev_divider::after {
    content: ">";
    position: absolute;
    top: 0;
    left: 0;
    animation: mx_SigninDevDividerScan 9s steps(57, end) infinite;
}

@keyframes mx_SigninDevDividerScan {
    from {
        transform: translateX(0ch);
    }

    to {
        transform: translateX(56ch);
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_SigninDev_divider::before {
        content: ">--------------------------------------------------------]";
    }

    .mx_SigninDev_divider::after {
        content: "";
        animation: none;
    }
}

.mx_SigninDev_tagline {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.66);
}

.mx_SigninDev_title {
    margin: 0 0 14px;
}

.mx_SigninDev .mx_ServerPicker_server {
    color: rgba(255, 255, 255, 0.86);
}

.mx_SigninDev .mx_ServerPicker_change {
    color: rgba(255, 255, 255, 0.74);
}

.mx_SigninDev .mx_AuthBody_changeFlow {
    color: rgba(255, 255, 255, 0.74);
}

@media only screen and (max-width: 560px) {
    .mx_SigninDev {
        padding: 16px;
    }

    .mx_SigninDev_body.mx_AuthBody {
        padding: 20px 14px 14px;
    }

    .mx_SigninDev_brand {
        font-size: 44px;
    }
}
